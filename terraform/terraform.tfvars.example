project_id = "my-gcp-project"
region     = "asia-northeast3"
zone       = "asia-northeast3-a"

machine_type = "e2-standard-4"
data_disk_gb = 200

# github 또는 gitlab
scm_provider = "github"
scm_api_base = "https://api.github.com"
# 자체 호스팅 GitLab 예시
# scm_provider = "gitlab"
# scm_api_base = "https://gitlab.example.com/api/v4"

scm_repos = [
  "sonmap/gcp_llm_mcp01",
]

# 1차는 읽기 전용으로 시작하세요.
allow_write = false
